---

import WhoWeAre from '../../Components/About/WhoWeAre';
import Navbar from '../../Layouts/Navbar.astro';
import SeoHeader from '../../Layouts/SeoHeader.astro';
import fr_navbar from '../../../language/fr/Navbar.json' assert { type: 'json' };
import "../../styles/global.css";
import about from '../../../language/fr/About.json' assert { type: 'json' };
import Hierarchy from '../../Components/About/Hierarchy';
import Chart from '../../Components/About/Chart';
import ValuesComponent from '../../Components/About/OurValues';
import FooterSection from '../../Layouts/Footer/FooterSection';
import fr from '../../../language/fr/Home.json' assert { type: 'json' };

---

<SeoHeader title="À propos de nous - Innovation Club">
    <main class="min-h-screen bg-zinc-950">
        <Navbar language={fr_navbar} />
        {/* Use flex column with consistent spacing */}
        <div class="flex flex-col">
            {/* Hero Section - WhoWeAre */}
            <section class="mb-24 sm:mb-32">
                <WhoWeAre language={about.Qui_nous_sommes} />
            </section>

            {/* Hierarchy Section */}
            <section class="mb-24 sm:mb-32">
                <Hierarchy language={about.Hierarchie} client:only />
            </section>

            {/* Chart Section */}
            <section class="mb-24 sm:mb-32">
                <Chart language={about.Evenements_et_Membres} client:load />
            </section>

            {/* Values Section */}
            <section class="mb-24 sm:mb-32">
                <ValuesComponent language={about.Nos_Valeurs} client:load />
            </section>

            {/* Footer */}
            <FooterSection language={fr.Footer} client:load />
        </div>
    </main>
</SeoHeader>