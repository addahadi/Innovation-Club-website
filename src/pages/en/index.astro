---
import SeoHeader from '../../Layouts/SeoHeader.astro';
import Hero from '../../Components/Landing/Hero';
import en from '../../../language/en/Home.json' assert { type: 'json' };
import en_navbar from '../../../language/en/Navbar.json' assert { type: 'json' };
import Navbar from '../../Layouts/Navbar.astro';
import About from '../../Components/Landing/About';
import Chart from '../../Components/About/Chart.tsx';
import FooterSection from '../../Layouts/Footer/FooterSection';
import "../../styles/global.css";
import Squares from '../../Components/Ui/Squares.jsx';
import CarouselEvent from '../../Components/Events/CarouselEvent.jsx';
import FAQ from '../../Components/Faq.tsx';
---

<SeoHeader title="Innovation with Astro">
    <Navbar language={en_navbar} />
    <div class="absolute inset-0 min-h-screen w-full">
        <Squares
            speed={0.5}
            squareSize={80}
            direction="diagonal"
            borderColor="#ffffff4d"
            hoverFillColor="#15803D"
            client:load
        />
    </div>

    {/* Hero takes full height */}
    <div class="min-h-screen">
        <Hero language={en} client:load/>
    </div>

    {/* Content sections with proper spacing */}
    <div class="relative z-10">
        <section class="py-12 md:py-32">
            <About language={en} client:load/>
        </section>

        <section class="py-12 md:py-32">
            <CarouselEvent language={en} client:load/>
        </section>

        <section class="py-12 md:py-32">
            <FAQ language={en} client:load/>
        </section>

        <FooterSection language={en} client:visible />
    </div>
</SeoHeader>