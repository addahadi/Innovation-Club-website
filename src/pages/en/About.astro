
---

import WhoWeAre from '../../Components/About/WhoWeAre';
import Navbar from '../../Layouts/Navbar.astro';
import SeoHeader from '../../Layouts/SeoHeader.astro';
import "../../styles/global.css";
import about from '../../../language/en/About.json' assert { type: 'json' };
import Hierarchy from '../../Components/About/Hierarchy';
import en_navbar from '../../../language/en/Navbar.json' assert { type: 'json' };
import Chart from '../../Components/About/Chart';
import ValuesComponent from '../../Components/About/OurValues';
import FooterSection from '../../Layouts/Footer/FooterSection';
import en from '../../../language/en/Home.json' assert { type: 'json' };
---


---
// ...existing imports...
---

---
// ...existing imports...
---

<SeoHeader title="À propos de nous - Innovation Club">
    <main class="min-h-screen bg-zinc-950">
        <Navbar language={en_navbar} />
        {/* Use flex column with consistent spacing */}
        <div class="flex flex-col">
            {/* Hero Section - WhoWeAre */}
            <section class="mb-24 sm:mb-32">
                <WhoWeAre language={about.Who_we_are} />
            </section>

            {/* Hierarchy Section */}
            <section class="mb-24 sm:mb-32">
                <Hierarchy language={about.Hierarchy} client:only />
            </section>

            {/* Chart Section */}
            <section class="mb-24 sm:mb-32">
                <Chart language={about.Events_and_Members} client:load />
            </section>

            {/* Values Section */}
            <section class="mb-24 sm:mb-32">
                <ValuesComponent language={about.Our_Values} client:load />
            </section>

            {/* Footer */}
            <FooterSection language={en.Footer} client:load />
        </div>
    </main>
</SeoHeader>