
---
import Menu from "../Components/Ui/Menu/Menu.js"

const {language} = Astro.props;

const menuItems = [
  { label: language.home, ariaLabel: "Go to home page", link: "/" },
  { label: language.about, ariaLabel: "Learn about us", link: "/about" },
  { label: language.events, ariaLabel: "View our events", link: "/events" },
  { label: language.contact, ariaLabel: "Get in touch", link: "/contact" },
];

const socialItems = [
  { label: "Twitter", link: "https://twitter.com" },
  { label: "GitHub", link: "https://github.com" },
  { label: "LinkedIn", link: "https://linkedin.com" },
];
---


<header >
    <nav class="w-full flex flex-row items-center justify-between px-8 py-2 text-white">
        <div class="flex flex-row-reverse gap-3 items-center">
            <img src="../../public/logo.jpg" width="70" class="rounded-full" alt="Innovation Club Logo" />
        </div>
        <Menu menuItems={menuItems} socialItems={socialItems} client:only/>    
    </nav>
</header>


