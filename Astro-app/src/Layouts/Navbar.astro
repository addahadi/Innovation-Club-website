
---
import Menu from "./Menu.js"

const {language} = Astro.props;

const menuItems = [
  { label: language.home, ariaLabel: "Go to home page", link : language.links.home },
  { label: language.about, ariaLabel: "Learn about us", link: language.links.about },
  { label: language.events, ariaLabel: "View our events", link: language.links.events },
  { label: language.contact, ariaLabel: "Get in touch", link: language.links.contact },
];

const socialItems = [
  { label: "Twitter", link: "https://twitter.com" },
  { label: "GitHub", link: "https://github.com" },
  { label: "LinkedIn", link: "https://linkedin.com" },
];
---


<header >
    <nav class=" text-white">
        <Menu menuItems={menuItems} socialItems={socialItems} client:only/>    
    </nav>
</header>


