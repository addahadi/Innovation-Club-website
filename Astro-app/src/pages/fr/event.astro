
---
import SeoHeader from '../../Layouts/SeoHeader.astro';
import "../../styles/global.css";
import fr_navbar from '../../../language/fr/Navbar.json' assert { type: 'json' };
import FooterSection from '../../Layouts/Footer/FooterSection';
import EventsGrid from '../../Components/Events/EventsGrid';
import EventsHero from '../../Components/Events/EventsHero';
import EventStats from '../../Components/Events/EventState';
import fr from '../../../language/fr/Home.json' assert { type: 'json' };
import fr_event from '../../../language/fr/Event.json' assert { type: 'json' };
import Header from '../../Layouts/Header.astro';
---

<SeoHeader title="Our Events - Innovation Club">
    <main class="min-h-screen bg-zinc-950">
        <Header language={fr_navbar} />
        
        <EventsHero 
         language={fr_event} client:load />
        
        <EventStats language={fr_event.states} client:load />
        
        <section class="py-20 px-4 md:px-8 max-w-7xl mx-auto">
           
            
            <EventsGrid client:load />
        </section>
        
        <FooterSection language={fr.Footer} client:load />
    </main>
</SeoHeader>